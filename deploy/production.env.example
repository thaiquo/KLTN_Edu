# Release identity. RELEASE_TAG must be an immutable Git commit SHA/tag.
DOMAIN=educonnect.example.com
GHCR_OWNER=your-github-owner
IMAGE_PREFIX=educonnect
RELEASE_TAG=

# Shared infrastructure credentials. Generate unique random values.
POSTGRES_DB=kltn_db
POSTGRES_USER=educonnect
POSTGRES_PASSWORD=
RABBITMQ_USERNAME=educonnect
RABBITMQ_PASSWORD=
JWT_SECRET=

# Browser authentication and mail.
JWT_EXPIRATION=900000
AUTH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_TOKEN_MAX_AGE=7d
MAIL_USERNAME=
MAIL_PASSWORD=

# Private object storage.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=production
CHAT_STORAGE_KEY_PREFIX=production/chat

# Sepolia settings. Operator writes are disabled until explicitly enabled below.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL_ALCHEMY=
BLOCKCHAIN_RPC_URL_PUBLICNODE=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_ESCROW_ADDRESS=
BLOCKCHAIN_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
BLOCKCHAIN_START_BLOCK=0
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_OPERATOR_ENABLED=false
BLOCKCHAIN_OPERATOR_ADDRESS=
# Use this only when the VPS operator is configured with a raw key in its private .env.
# Never commit the real value or print the resolved Compose configuration.
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=

# Escrow trial rollout kill switch. Keep false through schema/code rollout and
# only enable after the trial-specific canary release gates have passed.
ESCROW_TRIAL_ENABLED=false
ESCROW_TRIAL_FUNDING_SAFETY_MARGIN=30m

# Alternative keystore inputs used only with compose.vps.operator.yaml.
BLOCKCHAIN_OPERATOR_KEYSTORE_HOST_PATH=./secrets/operator-keystore.json
BLOCKCHAIN_OPERATOR_PASSWORD_FILE_HOST_PATH=./secrets/operator-keystore-password

# Optional AI profile.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Initial safety limits for the 2-vCPU/8-GB demo VPS; validate under load.
POSTGRES_MEMORY_LIMIT=1g
RABBITMQ_MEMORY_LIMIT=512m
GOTENBERG_MEMORY_LIMIT=768m
GATEWAY_MEMORY_LIMIT=384m
ACCOUNT_MEMORY_LIMIT=640m
LEARNING_MEMORY_LIMIT=768m
CONTRACT_MEMORY_LIMIT=768m
NOTIFICATION_MEMORY_LIMIT=640m
WEB_MEMORY_LIMIT=128m
CADDY_MEMORY_LIMIT=128m
AI_MEMORY_LIMIT=768m
QDRANT_MEMORY_LIMIT=768m

# Frontend VITE_* values are public build-time settings. Configure these as
# GitHub Actions variables/secrets when publishing the Web image, not here.
# VITE_API_URL=https://educonnect.example.com
# VITE_API_GATEWAY_URL=https://educonnect.example.com
# VITE_REALTIME_URL=wss://educonnect.example.com
# VITE_DEFAULT_CHAIN_ID=11155111
# VITE_ESCROW_CONTRACT_ADDRESS=
# VITE_USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_PROJECT_ID_WALLETCONNECT=
