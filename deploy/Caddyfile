{$DOMAIN} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy api-gateway:8080
	}

	@websocket path /ws/*
	handle @websocket {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy frontend-web:8080
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	log {
		output stdout
		format json
	}
}
