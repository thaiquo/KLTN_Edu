# ==============================================================================
#             EDUCONNECT PLATFORM - MASTER ENVIRONMENT TEMPLATE (.env.example)
#   (Tập tin mẫu cấu hình dùng chung để đẩy lên Git - KHÔNG CHỨA BÍ MẬT)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH MÔI TRƯỜNG & DATABASE (POSTGRESQL)
# ------------------------------------------------------------------------------
APP_ENV=dev
POSTGRES_PORT=5434
POSTGRES_DB=kltn_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DB_URL=jdbc:postgresql://localhost:5434/kltn_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC (JWT AUTHENTICATION)
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_base64_string_min_256_bits
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 3. MESSAGE BROKER & DỊCH VỤ CHUYỂN ĐỔI FILE (RABBITMQ & GOTENBERG)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

GOTENBERG_PORT=3000
CONTRACT_CONVERTER_URL=http://localhost:3000/forms/libreoffice/convert

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH MICROSERVICES & PORTS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
API_GATEWAY_PORT=8080
ACCOUNT_SERVICE_PORT=8081
LEARNING_SERVICE_PORT=8082
CONTRACT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
AI_SERVICE_PORT=8085

ACCOUNT_SERVICE_URL=http://localhost:8081
LEARNING_SERVICE_URL=http://localhost:8082
CONTRACT_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
AI_SERVICE_URL=http://localhost:8085

# ------------------------------------------------------------------------------
# 5. DỊCH VỤ EMAIL & OTP (GMAIL SMTP)
# ------------------------------------------------------------------------------
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
OTP_MAX_ATTEMPTS=5
OTP_EXPIRATION=5m
OTP_RESEND_COOLDOWN=60s
OTP_LOG_TO_CONSOLE=false

# ------------------------------------------------------------------------------
# 6. LƯU TRỮ ĐÁM MÂY (AWS S3 STORAGE)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_KEY_PREFIX=dev
S3_PRESIGNED_URL_DURATION=10m

# ------------------------------------------------------------------------------
# 7. HỢP ĐỒNG THÔNG MINH & BLOCKCHAIN (SEPOLIA TESTNET)
# ------------------------------------------------------------------------------
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BLOCKCHAIN_RPC_URL_ALCHEMY=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BLOCKCHAIN_RPC_URL_PUBLICNODE=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_ESCROW_ADDRESS=your_escrow_contract_address
BLOCKCHAIN_USDC_ADDRESS=your_usdc_contract_address
BLOCKCHAIN_TOKEN_DECIMALS=6
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_START_BLOCK=0
BLOCKCHAIN_EVENT_BLOCK_BATCH_SIZE=10
BLOCKCHAIN_EVENT_POLL_INITIAL_DELAY_MS=5000
BLOCKCHAIN_EVENT_POLL_INTERVAL_MS=5000

# Operator Wallet (Ví hệ thống phân xử & giải ngân on-chain)
BLOCKCHAIN_OPERATOR_ENABLED=false
BLOCKCHAIN_OPERATOR_ADDRESS=your_operator_wallet_address
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=your_operator_private_key_without_0x
BLOCKCHAIN_OPERATOR_KEYSTORE_PATH=
BLOCKCHAIN_OPERATOR_KEYSTORE_PASSWORD=
ETHERSCAN_API_KEY=your_etherscan_api_key

# ------------------------------------------------------------------------------
# 8. CẤU HÌNH FRONTEND WEB (VITE & WEB3 PROVIDER)
# ------------------------------------------------------------------------------
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080
VITE_REALTIME_URL=http://localhost:8080/api/notifications/ws
VITE_DEFAULT_CHAIN_ID=11155111
VITE_ESCROW_CONTRACT_ADDRESS=your_escrow_contract_address
VITE_USDC_CONTRACT_ADDRESS=your_usdc_contract_address
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
VITE_PROJECT_ID_WALLETCONNECT=your_walletconnect_project_id

# ------------------------------------------------------------------------------
# 9. CẤU HÌNH MOBILE APP (EXPO)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
