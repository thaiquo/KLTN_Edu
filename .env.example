BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_ESCROW_ADDRESS=
BLOCKCHAIN_USDC_ADDRESS=
BLOCKCHAIN_TOKEN_DECIMALS=6
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_START_BLOCK=0
BLOCKCHAIN_EVENT_BLOCK_BATCH_SIZE=500
BLOCKCHAIN_EVENT_POLL_INITIAL_DELAY_MS=5000
BLOCKCHAIN_EVENT_POLL_INTERVAL_MS=5000
# Keep operator writes disabled until a dedicated local/testnet keystore exists.
# Never use a MetaMask seed phrase or a student's/tutor's private key here.
BLOCKCHAIN_OPERATOR_ENABLED=false
BLOCKCHAIN_OPERATOR_ADDRESS=
BLOCKCHAIN_OPERATOR_KEYSTORE_PATH=
BLOCKCHAIN_OPERATOR_KEYSTORE_PASSWORD=
