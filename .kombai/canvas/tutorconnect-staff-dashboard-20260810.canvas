   <div class=\"flex items-center gap-4\" data-kid=\"1-3-2-3-3-1\" data-name=\"pagination info container\">\n                        <span data-kid=\"1-3-2-3-3-1-1\" data-name=\"pagination label\">\n                            Hiển thị 4/156 hồ sơ\n                        </span>\n                        <span class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"1-3-2-3-3-1-2\" data-name=\"dot separator\">\n                        </span>\n                        <div class=\"text-[var(--lime)] animate-pulse hidden\" data-dynamic=\"true\" data-kid=\"1-3-2-3-3-1-3\" data-name=\"cloud update status label\" data-reason=\"text and color updated by status update script\" id=\"status-label\">\n                            DỮ LIỆU ĐÃ ĐƯỢC CẬP NHẬT TRÊN CLOUD\n                        </div>\n                    </div>\n                    <div class=\"flex gap-6\" data-kid=\"1-3-2-3-3-2\" data-name=\"pagination navigation\">\n                        <button class=\"hover:text-white transition-colors flex items-center gap-1\" data-kid=\"1-3-2-3-3-2-1\" data-name=\"prev page button\">\n                            <i class=\"ti ti-chevron-left\" data-kid=\"1-3-2-3-3-2-1-1\" data-name=\"arrow left icon\">\n                            </i>\n                            Trang trước\n                        </button>\n                        <button class=\"hover:text-white transition-colors flex items-center gap-1\" data-kid=\"1-3-2-3-3-2-2\" data-name=\"next page button\">\n                            Trang sau\n                            <i class=\"ti ti-chevron-right\" data-kid=\"1-3-2-3-3-2-2-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n            <!-- SLA TIME SPINE (Right Tall) -->\n            <div class=\"col-span-4 row-span-4 bento-card p-6 flex flex-col group/spine\" data-kid=\"1-3-2-4\" data-name=\"sla monitor bento card\">\n                <div class=\"flex items-center justify-between mb-8\" data-kid=\"1-3-2-4-1\" data-name=\"sla card header\">\n                    <h3 class=\"text-[11px] font-bold uppercase tracking-[0.2em] flex items-center gap-2 font-heading\" data-kid=\"1-3-2-4-1-1\" data-name=\"sla monitor title\">\n                        <i class=\"ti ti-timeline text-[var(--magenta)]\" data-kid=\"1-3-2-4-1-1-1\" data-name=\"timeline icon\">\n                        </i>\n                        SLA Monitor Time-Spine\n                    </h3>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-2-4-1-2\" data-name=\"sla monitor status\">\n                        <span class=\"text-[9px] text-white/30 font-mono\" data-kid=\"1-3-2-4-1-2-1\" data-name=\"total hours label\">\n                            T: 47H\n                        </span>\n                        <span class=\"px-2 py-0.5 bg-[var(--magenta)]/20 text-[var(--magenta)] text-[9px] font-bold border border-[var(--magenta)]/30\" data-kid=\"1-3-2-4-1-2-2\" data-name=\"live status badge\">\n                            LIVE\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex-1 relative ml-3 border-l border-white/10\" data-kid=\"1-3-2-4-2\" data-name=\"spine container\">\n                    <!-- Spine markers -->\n                    <div class=\"absolute -left-[0.5px] top-0 flex flex-col gap-10 w-full py-4\" data-kid=\"1-3-2-4-2-1\" data-name=\"spine markers list\">\n                        <!-- Marker 1 (Critical) -->\n                        <div class=\"relative flex items-start group\" data-kid=\"1-3-2-4-2-1-1\" data-name=\"critical marker 1\">\n                            <div class=\"w-3 h-3 rounded-full bg-[var(--magenta)] pulse-magenta absolute -left-[6px] border-2 border-[var(--bg-dark)] z-10\" data-kid=\"1-3-2-4-2-1-1-1\" data-name=\"marker pulse indicator\">\n                            </div>\n                            <div class=\"ml-8 p-4 bg-white/2 border border-white/5 rounded-sm w-full group-hover:bg-white/5 transition-all duration-300 transform group-hover:translate-x-1 group-hover:border-[var(--magenta)]/20\" data-kid=\"1-3-2-4-2-1-1-2\" data-name=\"marker info card\">\n                                <div class=\"flex justify-between items-start mb-1\" data-kid=\"1-3-2-4-2-1-1-2-1\" data-name=\"marker name row\">\n                                    <span class=\"text-[12px] font-bold text-white\" data-kid=\"1-3-2-4-2-1-1-2-1-1\" data-name=\"tutor name\">\n                                        Nguyễn Văn C\n                                    </span>\n                                    <span class=\"text-[10px] text-[var(--magenta)] font-mono font-bold px-1.5 py-0.5 bg-[var(--magenta)]/10\" data-kid=\"1-3-2-4-2-1-1-2-1-2\" data-name=\"sla hours badge\">\n                                        47H\n                                    </span>\n                                </div>\n                                <div class=\"text-[9px] text-white/40 uppercase tracking-widest font-bold\" data-kid=\"1-3-2-4-2-1-1-2-2\" data-name=\"sla alert status\">\n                                    Hồ sơ quá hạn mức ĐỎ\n                                </div>\n                            </div>\n                        </div>\n                        <!-- Marker 2 (Critical) -->\n                        <div class=\"relative flex items-start group\" data-kid=\"1-3-2-4-2-1-2\" data-name=\"critical marker 2\">\n                            <div class=\"w-3 h-3 rounded-full bg-[var(--magenta)]/80 absolute -left-[6px] border-2 border-[var(--bg-dark)] z-10\" data-kid=\"1-3-2-4-2-1-2-1\" data-name=\"marker dot\">\n                            </div>\n                            <div class=\"ml-8 p-4 bg-white/2 border border-white/5 rounded-sm w-full group-hover:bg-white/5 transition-all duration-300 transform group-hover:translate-x-1\" data-kid=\"1-3-2-4-2-1-2-2\" data-name=\"marker info card\">\n                                <div class=\"flex justify-between items-start mb-1\" data-kid=\"1-3-2-4-2-1-2-2-1\" data-name=\"marker name row\">\n                                    <span class=\"text-[12px] font-bold text-white/80\" data-kid=\"1-3-2-4-2-1-2-2-1-1\" data-name=\"tutor name\">\n                                        Lê Hoàng Yến\n                                    </span>\n                                    <span class=\"text-[10px] text-[var(--magenta)]/80 font-mono font-bold\" data-kid=\"1-3-2-4-2-1-2-2-1-2\" data-name=\"sla hours badge\">\n                                        42H\n                                    </span>\n                                </div>\n                                <div class=\"text-[9px] text-white/40 uppercase tracking-widest font-bold\" data-kid=\"1-3-2-4-2-1-2-2-2\" data-name=\"sla alert status\">\n                                    Ưu tiên xử lý cấp 2\n                                </div>\n                            </div>\n                        </div>\n                        <!-- Marker 3 (Warning) -->\n                        <div class=\"relative flex items-start group\" data-kid=\"1-3-2-4-2-1-3\" data-name=\"warning marker\">\n                            <div class=\"w-3 h-3 rounded-full bg-[var(--magenta)]/40 absolute -left-[6px] border-2 border-[var(--bg-dark)] z-10\" data-kid=\"1-3-2-4-2-1-3-1\" data-name=\"marker dot\">\n                            </div>\n                            <div class=\"ml-8 p-4 bg-white/2 border border-white/5 rounded-sm w-full group-hover:bg-white/5 transition-all duration-300 transform group-hover:translate-x-1\" data-kid=\"1-3-2-4-2-1-3-2\" data-name=\"marker info card\">\n                                <div class=\"flex justify-between items-start mb-1\" data-kid=\"1-3-2-4-2-1-3-2-1\" data-name=\"marker name row\">\n                                    <span class=\"text-[12px] font-bold text-white/70\" data-kid=\"1-3-2-4-2-1-3-2-1-1\" data-name=\"tutor name\">\n                                        Trần Quốc Bảo\n                                    </span>\n                                    <span class=\"text-[10px] text-[var(--magenta)]/60 font-mono font-bold\" data-kid=\"1-3-2-4-2-1-3-2-1-2\" data-name=\"sla hours badge\">\n                                        26H\n                                    </span>\n                                </div>\n                                <div class=\"text-[9px] text-white/40 uppercase tracking-widest font-bold\" data-kid=\"1-3-2-4-2-1-3-2-2\" data-name=\"sla alert status\">\n                                    Giai đoạn cảnh báo\n                                </div>\n                            </div>\n                        </div>\n                        <!-- Marker 4 (Safe) -->\n                        <div class=\"relative flex items-start group\" data-kid=\"1-3-2-4-2-1-4\" data-name=\"safe marker\">\n                            <div class=\"w-3 h-3 rounded-full bg-white/20 absolute -left-[6px] border-2 border-[var(--bg-dark)] z-10\" data-kid=\"1-3-2-4-2-1-4-1\" data-name=\"marker dot\">\n                            </div>\n                            <div class=\"ml-8 p-4 bg-white/2 border border-white/5 rounded-sm w-full opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"1-3-2-4-2-1-4-2\" data-name=\"marker info card\">\n                                <div class=\"flex justify-between items-start mb-1\" data-kid=\"1-3-2-4-2-1-4-2-1\" data-name=\"marker name row\">\n                                    <span class=\"text-[12px] font-bold text-white/50\" data-kid=\"1-3-2-4-2-1-4-2-1-1\" data-name=\"tutor name\">\n                                        Phạm Mỹ Linh\n                                    </span>\n                                    <span class=\"text-[10px] text-white/30 font-mono\" data-kid=\"1-3-2-4-2-1-4-2-1-2\" data-name=\"sla hours badge\">\n                                        08H\n                                    </span>\n                                </div>\n                                <div class=\"text-[9px] text-white/20 uppercase tracking-widest font-bold\" data-kid=\"1-3-2-4-2-1-4-2-2\" data-name=\"sla alert status\">\n                                    Ngưỡng an toàn\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- PROPORTIONAL SUBJECT STATS (Bottom) -->\n            <div class=\"col-span-8 row-span-1 bento-card p-6 pb-12 flex flex-col relative overflow-hidden group\" data-kid=\"1-3-2-5\" data-name=\"subject stats bento card\">\n                <div class=\"absolute top-4 right-4 opacity-5 text-7xl pointer-events-none font-bold font-heading\" data-kid=\"1-3-2-5-1\" data-name=\"background watermark text\">\n                    SUBJECTS\n                </div>\n                <div class=\"flex items-center justify-between mb-6 relative z-10\" data-kid=\"1-3-2-5-2\" data-name=\"stats header\">\n                    <h3 class=\"text-[11px] font-bold uppercase tracking-[0.2em] flex items-center gap-2 font-heading\" data-kid=\"1-3-2-5-2-1\" data-name=\"header title\">\n                        <i class=\"ti ti-chart-bar text-[var(--lime)]\" data-kid=\"1-3-2-5-2-1-1\" data-name=\"chart icon\">\n                        </i>\n                        Phân bổ môn học đăng ký (24h)\n                    </h3>\n                    <div class=\"flex items-center gap-4 text-[10px] text-white/30 font-mono\" data-kid=\"1-3-2-5-2-2\" data-name=\"stats metadata\">\n                        <span class=\"flex items-center gap-1\" data-kid=\"1-3-2-5-2-2-1\" data-name=\"growth percentage\">\n                            <span class=\"w-2 h-0.5 bg-[var(--lime)]\" data-kid=\"1-3-2-5-2-2-1-1\" data-name=\"growth indicator bar\">\n                            </span>\n                            GROWTH: +12%\n                        </span>\n                        <span data-kid=\"1-3-2-5-2-2-2\" data-name=\"update time\">\n                            UPDATE: 12:45 PM\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex h-16 w-full gap-1 items-end relative z-10\" data-kid=\"1-3-2-5-3\" data-name=\"proportional blocks container\">\n                    <!-- Proportional blocks -->\n                    <div class=\"h-full bg-[var(--lime)]/30 border-b-2 border-[var(--lime)] flex flex-col items-center justify-center relative group/stat cursor-pointer hover:bg-[var(--lime)]/40 transition-colors glow-lime\" data-kid=\"1-3-2-5-3-1\" data-name=\"math stat block\" style=\"width: 45%;\">\n                        <span class=\"text-[11px] font-bold text-[var(--lime)] opacity-100 group-hover/stat:scale-110 transition-transform\" data-kid=\"1-3-2-5-3-1-1\" data-name=\"math percentage\">\n                            45%\n                        </span>\n                        <div class=\"absolute -bottom-7 left-0 text-[10px] text-white/40 whitespace-nowrap uppercase font-bold tracking-tighter\" data-kid=\"1-3-2-5-3-1-2\" data-name=\"math label\">\n                            Toán học\n                        </div>\n                    </div>\n                    <div class=\"h-[80%] bg-[var(--lime)]/20 border-b-2 border-[var(--lime)]/70 flex flex-col items-center justify-center relative group/stat cursor-pointer hover:bg-[var(--lime)]/30 transition-colors\" data-kid=\"1-3-2-5-3-2\" data-name=\"language stat block\" style=\"width: 30%;\">\n                        <span class=\"text-[11px] font-bold text-white/60 opacity-100 group-hover/stat:scale-110 transition-transform\" data-kid=\"1-3-2-5-3-2-1\" data-name=\"language percentage\">\n                            30%\n                        </span>\n                        <div class=\"absolute -bottom-7 left-0 text-[10px] text-white/40 whitespace-nowrap uppercase font-bold tracking-tighter\" data-kid=\"1-3-2-5-3-2-2\" data-name=\"language label\">\n                            Ngoại ngữ\n                        </div>\n                    </div>\n                    <div class=\"h-[60%] bg-[var(--lime)]/15 border-b-2 border-[var(--lime)]/50 flex flex-col items-center justify-center relative group/stat cursor-pointer hover:bg-[var(--lime)]/20 transition-colors\" data-kid=\"1-3-2-5-3-3\" data-name=\"physics stat block\" style=\"width: 10%;\">\n                        <span class=\"text-[11px] font-bold text-white/40 opacity-100\" data-kid=\"1-3-2-5-3-3-1\" data-name=\"physics percentage\">\n                            10%\n                        </span>\n                        <div class=\"absolute -bottom-7 left-0 text-[10px] text-white/40 whitespace-nowrap uppercase font-bold tracking-tighter\" data-kid=\"1-3-2-5-3-3-2\" data-name=\"physics label\">\n                            Vật lý\n                        </div>\n                    </div>\n                    <div class=\"h-[45%] bg-[var(--lime)]/10 border-b-2 border-[var(--lime)]/30 flex flex-col items-center justify-center relative group/stat cursor-pointer hover:bg-[var(--lime)]/15 transition-colors\" data-kid=\"1-3-2-5-3-4\" data-name=\"chemistry stat block\" style=\"width: 8%;\">\n                        <span class=\"text-[9px] font-bold text-white/30\" data-kid=\"1-3-2-5-3-4-1\" data-name=\"chemistry percentage\">\n                            8%\n                        </span>\n                        <div class=\"absolute -bottom-7 left-0 text-[10px] text-white/40 whitespace-nowrap uppercase font-bold tracking-tighter\" data-kid=\"1-3-2-5-3-4-2\" data-name=\"chemistry label\">\n                            Hóa học\n                        </div>\n                    </div>\n                    <div class=\"h-[35%] bg-[var(--lime)]/5 border-b-2 border-[var(--lime)]/10 flex flex-col items-center justify-center relative group/stat cursor-pointer hover:bg-[var(--lime)]/10 transition-colors\" data-kid=\"1-3-2-5-3-5\" data-name=\"literature stat block\" style=\"width: 7%;\">\n                        <span class=\"text-[9px] font-bold text-white/20\" data-kid=\"1-3-2-5-3-5-1\" data-name=\"literature percentage\">\n                            7%\n                        </span>\n                        <div class=\"absolute -bottom-7 left-0 text-[10px] text-white/40 whitespace-nowrap uppercase font-bold tracking-tighter\" data-kid=\"1-3-2-5-3-5-2\" data-name=\"literature label\">\n                            Ngữ văn\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Footer / Live Activity -->\n        <footer class=\"mt-6 flex justify-between items-center text-[10px] text-white/20 font-mono border-t border-white/5 pt-5 uppercase tracking-[0.25em]\" data-kid=\"1-3-3\" data-name=\"footer info\">\n            <div class=\"flex items-center gap-8\" data-kid=\"1-3-3-1\" data-name=\"footer left status\">\n                <div class=\"flex items-center gap-3 bg-white/5 px-3 py-1 border border-white/5 rounded-full\" data-kid=\"1-3-3-1-1\" data-name=\"staff indicator\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--lime)] shadow-[0_0_8px_var(--lime)] animate-pulse\" data-kid=\"1-3-3-1-1-1\" data-name=\"indicator light\">\n                    </span>\n                    <span class=\"text-[var(--lime)]/80\" data-kid=\"1-3-3-1-1-2\" data-name=\"staff id\">\n                        OPERATOR_ID: STAFF_4091\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-3-3-1-2\" data-name=\"sync status group\">\n                    <span class=\"text-white/40\" data-kid=\"1-3-3-1-2-1\" data-name=\"sync status text\">\n                        LAST SYNC: TS-98230 DUYỆT THÀNH CÔNG\n                    </span>\n                    <span class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"1-3-3-1-2-2\" data-name=\"dot separator\">\n                    </span>\n                    <span data-kid=\"1-3-3-1-2-3\" data-name=\"uptime status\">\n                        UPTIME: 142:54:12\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-3-3-2\" data-name=\"footer right info\">\n                <span data-kid=\"1-3-3-2-1\" data-name=\"copyright text\">\n                    © 2026 TUTORCONNECT SECURED PANEL\n                </span>\n                <span class=\"px-2 py-0.5 border border-white/10 rounded-sm\" data-kid=\"1-3-3-2-2\" data-name=\"version tag\">\n                    V3.4.0-STABLE\n                </span>\n            </div>\n        </footer>\n    </main>\n    <script>\n        (function() {\n            // Update clock\n            function updateClock() {\n                const now = new Date();\n                const hours = String(now.getHours()).padStart(2, '0');\n                const minutes = String(now.getMinutes()).padStart(2, '0');\n                const seconds = String(now.getSeconds()).padStart(2, '0');\n                const clockEl = document.getElementById('current-time');\n                if(clockEl) clockEl.textContent = `${hours}:${minutes}:${seconds} ICT`;\n            }\n            setInterval(updateClock, 1000);\n            updateClock();\n\n            // Row highlighting\n            window.toggleActive = function(row) {\n                const rows = document.querySelectorAll('#tutor-queue tr');\n                rows.forEach(r => r.classList.remove('active-row'));\n                row.classList.add('active-row');\n            };\n\n            // Status update simulation\n            window.updateStatus = function(btn, type) {\n                const label = document.getElementById('status-label');\n                if(!label) return;\n                \n                label.textContent = type === 'OK' ? 'HỒ SƠ ĐÃ ĐƯỢC CHẤP THUẬN TRÊN HỆ THỐNG' : 'THÔNG BÁO BỔ SUNG ĐÃ ĐƯỢC GỬI ĐẾN GIA SƯ';\n                label.style.color = type === 'OK' ? 'var(--lime)' : 'var(--magenta)';\n                label.classList.remove('hidden');\n                \n                setTimeout(() => {\n                    label.classList.add('hidden');\n                }, 4000);\n\n                // Mock update table row state\n                const row = btn.closest('tr');\n                if(row) {\n                    row.style.opacity = '0.4';\n                    row.style.pointerEvents = 'none';\n                    row.style.filter = 'grayscale(1)';\n                    row.classList.remove('active-row');\n                }\n            };\n        })();\n    </script>\n</div>\n",
