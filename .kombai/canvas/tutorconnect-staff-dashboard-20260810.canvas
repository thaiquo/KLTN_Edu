    "var_0c4ba59930ce": {
      "type": "variant",
      "label": "Variant 3 · Dark Ops Terminal",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;600;700&family=Overpass:wght@300;400;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --bg-dark: #010B13;\n        --surface-dark: #1A2029;\n        --lime: #80FF00;\n        --magenta: #FF00FF;\n        --border-color: rgba(255, 255, 255, 0.08);\n    }\n\n    .dashboard-root {\n        background-color: var(--bg-dark);\n        color: rgba(255, 255, 255, 0.9);\n        font-family: 'Overpass', sans-serif;\n        min-height: 100vh;\n        display: flex;\n        overflow-x: clip;\n    }\n\n    .font-heading {\n        font-family: 'Schibsted Grotesk', sans-serif;\n    }\n\n    .bento-card {\n        background-color: var(--surface-dark);\n        border: 1px solid var(--border-color);\n        border-radius: 4px;\n        transition: all 0.2s ease;\n    }\n\n    .bento-card:hover {\n        border-color: rgba(255, 255, 255, 0.15);\n        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);\n    }\n\n    .active-row {\n        background-color: rgba(128, 255, 0, 0.03);\n        outline: 1px solid var(--lime);\n        outline-offset: -1px;\n    }\n\n    /* Custom scrollbar */\n    .custom-scroll::-webkit-scrollbar {\n        width: 4px;\n        height: 4px;\n    }\n    .custom-scroll::-webkit-scrollbar-track {\n        background: transparent;\n    }\n    .custom-scroll::-webkit-scrollbar-thumb {\n        background: rgba(255, 255, 255, 0.1);\n        border-radius: 10px;\n    }\n    .custom-scroll::-webkit-scrollbar-thumb:hover {\n        background: rgba(255, 255, 255, 0.2);\n    }\n\n    /* Time spine marker pulse */\n    @keyframes magentaPulse {\n        0% { box-shadow: 0 0 0 0 rgba(255, 0, 255, 0.4); }\n        70% { box-shadow: 0 0 0 6px rgba(255, 0, 255, 0); }\n        100% { box-shadow: 0 0 0 0 rgba(255, 0, 255, 0); }\n    }\n    .pulse-magenta {\n        animation: magentaPulse 2s infinite;\n    }\n    @keyframes limeGlow {\n        0%, 100% { box-shadow: 0 0 5px rgba(128, 255, 0, 0.2); }\n        50% { box-shadow: 0 0 15px rgba(128, 255, 0, 0.4); }\n    }\n    .glow-lime {\n        animation: limeGlow 3s infinite;\n    }\n\n    /* Progress ring animation */\n    .progress-ring__circle {\n        transition: stroke-dashoffset 0.35s;\n        transform: rotate(-90deg);\n        transform-origin: 50% 50%;\n    }\n\n    /* Grid lines terminal effect */\n    .terminal-overlay {\n        position: fixed;\n        inset: 0;\n        pointer-events: none;\n        background-image: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));\n        background-size: 100% 2px, 3px 100%;\n        z-index: 100;\n        opacity: 0.1;\n    }\n</style>\n<div class=\"dashboard-root\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"terminal-overlay\" data-kid=\"1-1\" data-name=\"terminal CRT effect overlay\">\n    </div>\n    <!-- Left Icon Rail Sidebar -->\n    <aside class=\"w-16 flex flex-col items-center py-6 border-r border-white/5 bg-[#01080E] sticky top-0 h-screen z-50 shrink-0\" data-kid=\"1-2\" data-name=\"sidebar navigation rail\">\n        <div class=\"mb-10 text-white flex items-center justify-center\" data-kid=\"1-2-1\" data-name=\"sidebar logo icon\">\n            <i class=\"ti ti-school text-3xl text-[var(--lime)]\" data-kid=\"1-2-1-1\" data-name=\"school graduation cap icon\">\n            </i>\n        </div>\n        <nav class=\"flex flex-col gap-8 flex-1\" data-kid=\"1-2-2\" data-name=\"sidebar navigation links container\">\n            <a class=\"group relative flex items-center justify-center w-10 h-10 rounded text-gray-500 hover:text-[var(--lime)] transition-colors\" data-kid=\"1-2-2-1\" data-name=\"dashboard navigation link\" href=\"#\" title=\"Tổng quan\">\n                <i class=\"ti ti-layout-dashboard text-2xl\" data-kid=\"1-2-2-1-1\" data-name=\"dashboard icon\">\n                </i>\n                <span class=\"absolute left-14 px-2 py-1 bg-black text-white text-[10px] uppercase font-bold tracking-widest rounded opacity-0 group-hover:opacity-100 pointer-events-none whitespace-nowrap z-50 transition-opacity border border-white/10\" data-kid=\"1-2-2-1-2\" data-name=\"dashboard tooltip\">\n                    Tổng quan\n                </span>\n            </a>\n            <a class=\"group relative flex items-center justify-center w-10 h-10 rounded text-[var(--lime)] bg-[var(--lime)]/5\" data-kid=\"1-2-2-2\" data-name=\"tutor approval navigation link\" href=\"#\" title=\"Duyệt gia sư\">\n                <i class=\"ti ti-user-check text-2xl\" data-kid=\"1-2-2-2-1\" data-name=\"user check icon\">\n                </i>\n                <span class=\"absolute left-14 px-2 py-1 bg-black text-white text-[10px] uppercase font-bold tracking-widest rounded opacity-0 group-hover:opacity-100 pointer-events-none whitespace-nowrap z-50 transition-opacity border border-white/10\" data-kid=\"1-2-2-2-2\" data-name=\"tutor approval tooltip\">\n                    Duyệt gia sư\n                </span>\n            </a>\n            <a class=\"group relative flex items-center justify-center w-10 h-10 rounded text-gray-500 hover:text-[var(--lime)] transition-colors\" data-kid=\"1-2-2-3\" data-name=\"users navigation link\" href=\"#\" title=\"Người dùng\">\n                <i class=\"ti ti-users text-2xl\" data-kid=\"1-2-2-3-1\" data-name=\"users icon\">\n                </i>\n                <span class=\"absolute left-14 px-2 py-1 bg-black text-white text-[10px] uppercase font-bold tracking-widest rounded opacity-0 group-hover:opacity-100 pointer-events-none whitespace-nowrap z-50 transition-opacity border border-white/10\" data-kid=\"1-2-2-3-2\" data-name=\"users tooltip\">\n                    Người dùng\n                </span>\n            </a>\n            <a class=\"group relative flex items-center justify-center w-10 h-10 rounded text-gray-500 hover:text-[var(--lime)] transition-colors\" data-kid=\"1-2-2-4\" data-name=\"reports navigation link\" href=\"#\" title=\"Báo cáo\">\n                <i class=\"ti ti-chart-bar text-2xl\" data-kid=\"1-2-2-4-1\" data-name=\"chart bar icon\">\n                </i>\n                <span class=\"absolute left-14 px-2 py-1 bg-black text-white text-[10px] uppercase font-bold tracking-widest rounded opacity-0 group-hover:opacity-100 pointer-events-none whitespace-nowrap z-50 transition-opacity border border-white/10\" data-kid=\"1-2-2-4-2\" data-name=\"reports tooltip\">\n                    Báo cáo\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto flex flex-col gap-6\" data-kid=\"1-2-3\" data-name=\"sidebar bottom tools container\">\n            <a class=\"group relative flex items-center justify-center w-10 h-10 rounded text-gray-500 hover:text-white transition-colors\" data-kid=\"1-2-3-1\" data-name=\"settings navigation link\" href=\"#\" title=\"Cài đặt\">\n                <i class=\"ti ti-settings text-2xl\" data-kid=\"1-2-3-1-1\" data-name=\"settings icon\">\n                </i>\n            </a>\n            <div class=\"w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center border border-white/10 overflow-hidden\" data-kid=\"1-2-3-2\" data-name=\"admin profile image container\">\n                <img alt=\"Staff\" class=\"w-full h-full object-cover\" data-kid=\"1-2-3-2-1\" data-name=\"admin profile image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/100?u=admin\"/>\n            </div>\n        </div>\n    </aside>\n    <!-- Main Content -->\n    <main class=\"flex-1 p-6 flex flex-col gap-6 max-w-[1214px] mx-auto overflow-x-clip relative z-10\" data-kid=\"1-3\" data-name=\"main content area\">\n        <!-- Header Info Bar -->\n        <header class=\"flex justify-between items-center mb-2\" data-kid=\"1-3-1\" data-name=\"header info bar\">\n            <div data-kid=\"1-3-1-1\" data-name=\"page title and version group\">\n                <h1 class=\"text-xl font-bold tracking-tight flex items-center gap-3 font-heading\" data-kid=\"1-3-1-1-1\" data-name=\"page title headline\">\n                    <span class=\"text-white/40 font-normal\" data-kid=\"1-3-1-1-1-1\" data-name=\"operations label\">\n                        OPERATIONS\n                    </span>\n                    <span class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"1-3-1-1-1-2\" data-name=\"dot separator\">\n                    </span>\n                    <span data-kid=\"1-3-1-1-1-3\" data-name=\"system name label\">\n                        HỆ THỐNG XÉT DUYỆT GIA SƯ\n                    </span>\n                </h1>\n                <p class=\"text-[10px] text-white/40 mt-1 uppercase tracking-[0.3em] font-mono\" data-kid=\"1-3-1-1-2\" data-name=\"version info text\">\n                    Variant 3 · Terminal Dark Ops · Ver 1.0.2\n                </p>\n            </div>\n            <div class=\"flex items-center gap-4 text-xs font-mono\" data-kid=\"1-3-1-2\" data-name=\"live server and time status container\">\n                <div class=\"flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded\" data-kid=\"1-3-1-2-1\" data-name=\"server status indicator\">\n                    <span class=\"w-2 h-2 rounded-full bg-[var(--lime)] animate-pulse\" data-kid=\"1-3-1-2-1-1\" data-name=\"live pulse circle\">\n                    </span>\n                    <span class=\"text-white/60\" data-kid=\"1-3-1-2-1-2\" data-name=\"server status text\">\n                        LIVE SERVER: VN-SOUTH-01\n                    </span>\n                </div>\n                <div class=\"text-white/60 tabular-nums\" data-kid=\"1-3-1-2-2\" data-name=\"live time display container\">\n                    <span data-dynamic=\"true\" data-kid=\"1-3-1-2-2-1\" data-name=\"clock time text\" data-reason=\"text updated every second by clock script\" id=\"current-time\">\n                        00:00:00 ICT\n                    </span>\n                </div>\n            </div>\n        </header>\n        <!-- Bento Grid Layout -->\n        <div class=\"grid grid-cols-12 grid-rows-6 gap-6 flex-1 min-h-[800px]\" data-kid=\"1-3-2\" data-name=\"bento grid layout container\">\n            <!-- ALERT CARD (Top Left - Largest) -->\n            <div class=\"col-span-8 row-span-2 bento-card p-8 flex flex-col justify-between relative overflow-hidden group\" data-kid=\"1-3-2-1\" data-name=\"alert bento card\">\n                <!-- Background decoration -->\n                <div class=\"absolute top-[-20%] right-[-10%] w-64 h-64 bg-[var(--magenta)]/5 blur-[100px] rounded-full group-hover:bg-[var(--magenta)]/10 transition-colors duration-500\" data-kid=\"1-3-2-1-1\" data-name=\"background glow effect\">\n                </div>\n                <div class=\"relative z-10\" data-kid=\"1-3-2-1-2\" data-name=\"alert text container\">\n                    <div class=\"inline-flex items-center gap-2 px-2 py-0.5 border border-[var(--magenta)]/30 text-[var(--magenta)] text-[10px] font-bold tracking-widest uppercase mb-4 bg-[var(--magenta)]/5\" data-kid=\"1-3-2-1-2-1\" data-name=\"SLA critical breach badge\">\n                        <i class=\"ti ti-alert-triangle-filled\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"alert triangle icon\">\n                        </i>\n                        SLA CRITICAL BREACH\n                    </div>\n                    <h2 class=\"text-4xl font-bold font-heading leading-tight max-w-md\" data-kid=\"1-3-2-1-2-2\" data-name=\"alert headline\">\n                        <span class=\"text-[var(--magenta)]\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"overdue count highlight\">\n                            15 hồ sơ\n                        </span>\n                        đã quá hạn\n                        <br data-kid=\"1-3-2-1-2-2-2\" data-name=\"line break\"/>\n                        phản hồi SLA 48h\n                    </h2>\n                    <p class=\"mt-4 text-white/50 text-sm max-w-md leading-relaxed\" data-kid=\"1-3-2-1-2-3\" data-name=\"alert description\">\n                        Thời gian phản hồi đang vượt ngưỡng quy định cho phép. Yêu cầu ưu tiên xử lý các hồ sơ có chứng chỉ sư phạm và khu vực trọng điểm (Hà Nội & TP.HCM).\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-4 relative z-10\" data-kid=\"1-3-2-1-3\" data-name=\"alert actions container\">\n                    <button class=\"bg-[var(--magenta)] hover:bg-[var(--magenta)]/90 text-black font-bold py-3 px-8 rounded-sm text-sm transition-all transform active:scale-95 flex items-center gap-2 shadow-[0_0_20px_rgba(255,0,255,0.4)] cursor-pointer\" data-kid=\"1-3-2-1-3-1\" data-name=\"primary action button\">\n                        XỬ LÝ NGAY\n                        <i class=\"ti ti-chevron-right text-lg\" data-kid=\"1-3-2-1-3-1-1\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                    <button class=\"text-white/40 hover:text-white text-[11px] font-bold uppercase tracking-widest transition-colors flex items-center gap-2\" data-kid=\"1-3-2-1-3-2\" data-name=\"secondary action link\">\n                        <span data-kid=\"1-3-2-1-3-2-1\" data-name=\"link text\">\n                            Xem chi tiết danh sách\n                        </span>\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"1-3-2-1-3-2-2\" data-name=\"arrow link icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- QUEUE HEALTH (Top Right) -->\n            <div class=\"col-span-4 row-span-2 bento-card p-6 flex flex-col items-center justify-center text-center relative overflow-hidden\" data-kid=\"1-3-2-2\" data-name=\"queue health bento card\">\n                <div class=\"absolute inset-0 opacity-10 pointer-events-none\" data-kid=\"1-3-2-2-1\" data-name=\"card background abstract art\">\n                    <svg data-kid=\"1-3-2-2-1-1\" data-name=\"background path\" height=\"100%\" preserveaspectratio=\"none\" viewbox=\"0 0 100 100\" width=\"100%\">\n                        <path d=\"M0,100 L0,80 L20,60 L40,70 L60,40 L80,50 L100,10 L100,100 Z\" fill=\"var(--lime)\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"relative inline-flex items-center justify-center z-10\" data-kid=\"1-3-2-2-2\" data-name=\"progress indicator container\">\n                    <svg class=\"w-32 h-32\" data-kid=\"1-3-2-2-2-1\" data-name=\"progress ring svg\">\n                        <circle class=\"text-white/5\" cx=\"64\" cy=\"64\" fill=\"transparent\" r=\"58\" stroke=\"currentColor\" stroke-width=\"6\">\n                        </circle>\n                        <circle class=\"text-[var(--lime)] progress-ring__circle\" cx=\"64\" cy=\"64\" fill=\"transparent\" r=\"58\" stroke=\"currentColor\" stroke-dasharray=\"364.4\" stroke-dashoffset=\"80.1\" stroke-linecap=\"round\" stroke-width=\"6\">\n                        </circle>\n                    </svg>\n                    <div class=\"absolute inset-0 flex flex-col items-center justify-center translate-y-1\" data-kid=\"1-3-2-2-2-2\" data-name=\"percentage label container\">\n                        <span class=\"text-3xl font-bold font-heading text-[var(--lime)] leading-none\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"percentage text\">\n                            78%\n                        </span>\n                        <span class=\"text-[9px] text-white/40 uppercase tracking-widest font-bold mt-1\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"score label\">\n                            Health Score\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-6 flex flex-col gap-2 w-full max-w-[200px] z-10\" data-kid=\"1-3-2-2-3\" data-name=\"health metrics list\">\n                    <div class=\"flex justify-between text-[10px] text-white/40 uppercase font-bold tracking-wider\" data-kid=\"1-3-2-2-3-1\" data-name=\"processed count header\">\n                        <span data-kid=\"1-3-2-2-3-1-1\" data-name=\"label text\">\n                            Đã duyệt (24h)\n                        </span>\n                        <span class=\"text-white\" data-kid=\"1-3-2-2-3-1-2\" data-name=\"count value\">\n                            142\n                        </span>\n                    </div>\n                    <div class=\"w-full h-1 bg-white/5 rounded-full overflow-hidden\" data-kid=\"1-3-2-2-3-2\" data-name=\"progress bar container\">\n                        <div class=\"h-full bg-[var(--lime)] w-[78%]\" data-kid=\"1-3-2-2-3-2-1\" data-name=\"progress bar fill\">\n                        </div>\n                    </div>\n                    <p class=\"text-[10px] text-white/30 mt-2 font-mono uppercase\" data-kid=\"1-3-2-2-3-3\" data-name=\"average metric text\">\n                        Avg: 4.2 min / app\n                    </p>\n                </div>\n            </div>\n            <!-- TABLE QUEUE (Middle Large) -->\n            <div class=\"col-span-8 row-span-3 bento-card overflow-hidden flex flex-col\" data-kid=\"1-3-2-3\" data-name=\"queue table bento card\">\n                <div class=\"p-4 border-b border-white/5 flex justify-between items-center bg-white/2\" data-kid=\"1-3-2-3-1\" data-name=\"table header bar\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-3-1-1\" data-name=\"header title group\">\n                        <i class=\"ti ti-list text-[var(--lime)] text-lg\" data-kid=\"1-3-2-3-1-1-1\" data-name=\"list icon\">\n                        </i>\n                        <h3 class=\"text-[11px] font-bold uppercase tracking-[0.2em] font-heading\" data-kid=\"1-3-2-3-1-1-2\" data-name=\"table title\">\n                            Danh sách đăng ký chờ duyệt\n                        </h3>\n                    </div>\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-3-2-3-1-2\" data-name=\"header controls\">\n                        <div class=\"flex items-center gap-2 text-[10px] text-white/40 font-bold uppercase\" data-kid=\"1-3-2-3-1-2-1\" data-name=\"online status indicator\">\n                            <span class=\"w-2 h-2 rounded-full bg-[var(--lime)] shadow-[0_0_8px_var(--lime)]\" data-kid=\"1-3-2-3-1-2-1-1\" data-name=\"indicator light\">\n                            </span>\n                            Trực tuyến\n                        </div>\n                        <div class=\"relative\" data-kid=\"1-3-2-3-1-2-2\" data-name=\"search input field\">\n                            <input class=\"bg-black/40 border border-white/10 rounded-sm px-3 py-1.5 text-[11px] focus:outline-none focus:border-[var(--lime)]/50 w-56 text-white/80 font-mono transition-all\" data-kid=\"1-3-2-3-1-2-2-1\" data-name=\"search input\" placeholder=\"Tìm kiếm gia sư...\" type=\"text\"/>\n                            <i class=\"ti ti-search absolute right-3 top-2 text-white/30 text-[10px]\" data-kid=\"1-3-2-3-1-2-2-2\" data-name=\"search icon\">\n                            </i>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"overflow-auto flex-1 custom-scroll\" data-kid=\"1-3-2-3-2\" data-name=\"table container\">\n                    <table class=\"w-full text-left text-[12px] border-collapse\" data-kid=\"1-3-2-3-2-1\" data-name=\"tutor queue table\">\n                        <thead data-kid=\"1-3-2-3-2-1-1\" data-name=\"table head\">\n                            <tr class=\"text-white/30 border-b border-white/5 bg-black/20 font-mono\" data-kid=\"1-3-2-3-2-1-1-1\" data-name=\"header row\">\n                                <th class=\"py-3 px-6 font-normal uppercase tracking-widest\" data-kid=\"1-3-2-3-2-1-1-1-1\" data-name=\"name header\">\n                                    Họ và Tên\n                                </th>\n                                <th class=\"py-3 px-4 font-normal uppercase tracking-widest\" data-kid=\"1-3-2-3-2-1-1-1-2\" data-name=\"subject header\">\n                                    Môn học\n                                </th>\n                                <th class=\"py-3 px-4 font-normal uppercase tracking-widest text-center\" data-kid=\"1-3-2-3-2-1-1-1-3\" data-name=\"cccd header\">\n                                    CCCD\n                                </th>\n                                <th class=\"py-3 px-4 font-normal uppercase tracking-widest text-center\" data-kid=\"1-3-2-3-2-1-1-1-4\" data-name=\"certificate header\">\n                                    Bằng cấp\n                                </th>\n                                <th class=\"py-3 px-4 font-normal uppercase tracking-widest\" data-kid=\"1-3-2-3-2-1-1-1-5\" data-name=\"time header\">\n                                    Thời gian\n                                </th>\n                                <th class=\"py-3 px-6 font-normal uppercase tracking-widest text-right\" data-kid=\"1-3-2-3-2-1-1-1-6\" data-name=\"status header\">\n                                    Trạng thái\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-3-2-3-2-1-2\" data-name=\"table body\" id=\"tutor-queue\">\n                            <!-- Active/Edit Row -->\n                            <tr class=\"active-row border-b border-white/5 group transition-all duration-300 hover:bg-[var(--lime)]/5 cursor-pointer\" data-kid=\"1-3-2-3-2-1-2-1\" data-name=\"active row\" onclick=\"toggleActive(this)\">\n                                <td class=\"py-5 px-6\" data-kid=\"1-3-2-3-2-1-2-1-1\" data-name=\"name cell\">\n                   