      "html": "<div class=\"flex h-screen w-full bg-[#F8F9FA] font-['Be_Vietnam_Pro'] text-[#003153] overflow-hidden select-none\" data-kid=\"1\" data-name=\"page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;600;700&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-heading { font-family: 'Instrument Sans', sans-serif; }\n        \n        .custom-scrollbar::-webkit-scrollbar { width: 6px; }\n        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }\n        .custom-scrollbar::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }\n\n        .sidebar-item { transition: all 0.2s ease; }\n        .sidebar-item.active { background: rgba(254, 111, 94, 0.1); border-left: 4px solid #FE6F5E; color: #FE6F5E; }\n        \n        .table-row { cursor: pointer; transition: all 0.2s ease; }\n        .table-row.selected { background-color: rgba(254, 111, 94, 0.06); border-left: 4px solid #FE6F5E; z-index: 10; position: relative; }\n\n        @keyframes pulse-ring {\n            0% { transform: scale(.5); opacity: 1; }\n            100% { transform: scale(2.5); opacity: 0; }\n        }\n        @keyframes marquee {\n            0% { transform: translateX(0); }\n            100% { transform: translateX(-50%); }\n        }\n        .ticker-scroll {\n            display: flex;\n            width: max-content;\n            animation: marquee 30s linear infinite;\n        }\n        .pulse-dot {\n            position: relative;\n        }\n        .pulse-dot::after {\n            content: '';\n            position: absolute;\n            left: 0; top: 0;\n            width: 100%; height: 100%;\n            border-radius: 50%;\n            background-color: currentColor;\n            animation: pulse-ring 2s infinite;\n        }\n\n        .swiss-grid {\n            background-size: 32px 32px;\n            background-image: radial-gradient(circle, #e5e7eb 0.5px, transparent 0.5px);\n        }\n    </style>\n    <!-- Sidebar -->\n    <aside class=\"w-[280px] h-full bg-[#003153] text-white flex flex-col shrink-0\" data-kid=\"1-1\" data-name=\"sidebar container\">\n        <div class=\"p-8 pb-12 flex items-center gap-4\" data-kid=\"1-1-1\" data-name=\"sidebar logo and branding section\">\n            <div class=\"w-12 h-12 bg-[#FE6F5E] flex items-center justify-center rounded-xs\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon wrapper\">\n                <i class=\"ti ti-school text-3xl text-white\" data-kid=\"1-1-1-1-1\" data-name=\"school icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand name and title group\">\n                <h1 class=\"font-heading font-bold text-2xl tracking-tighter leading-none uppercase\" data-kid=\"1-1-1-2-1\" data-name=\"app name headline\">\n                    TutorConnect\n                </h1>\n                <p class=\"text-xs opacity-50 font-bold tracking-[0.2em] mt-1\" data-kid=\"1-1-1-2-2\" data-name=\"admin center badge\">\n                    ADMIN CENTER\n                </p>\n            </div>\n        </div>\n        <nav class=\"flex-1 px-4 space-y-2\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-3 text-white/70 hover:text-white hover:bg-white/5 rounded-sm\" data-kid=\"1-1-2-1\" data-name=\"navigation link overview\" href=\"#\">\n                <i class=\"ti ti-dashboard text-xl\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon\">\n                </i>\n                <span class=\"font-medium\" data-kid=\"1-1-2-1-2\" data-name=\"dashboard menu label\">\n                    Tổng quan\n                </span>\n            </a>\n            <a class=\"sidebar-item active flex items-center justify-between px-4 py-3 rounded-sm\" data-kid=\"1-1-2-2\" data-name=\"navigation link pending profiles\" href=\"#\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-2-1\" data-name=\"pending profiles group\">\n                    <i class=\"ti ti-clipboard-check text-xl\" data-kid=\"1-1-2-2-1-1\" data-name=\"clipboard icon\">\n                    </i>\n                    <span class=\"font-medium\" data-kid=\"1-1-2-2-1-2\" data-name=\"pending profiles menu label\">\n                        Duyệt hồ sơ gia sư\n                    </span>\n                </div>\n                <span class=\"w-2 h-2 bg-[#FE6F5E] rounded-full\" data-kid=\"1-1-2-2-2\" data-name=\"notification dot\">\n                </span>\n            </a>\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-3 text-white/70 hover:text-white hover:bg-white/5 rounded-sm\" data-kid=\"1-1-2-3\" data-name=\"navigation link user management\" href=\"#\">\n                <i class=\"ti ti-users text-xl\" data-kid=\"1-1-2-3-1\" data-name=\"users icon\">\n                </i>\n                <span class=\"font-medium\" data-kid=\"1-1-2-3-2\" data-name=\"user management menu label\">\n                    Quản lý người dùng\n                </span>\n            </a>\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-3 text-white/70 hover:text-white hover:bg-white/5 rounded-sm\" data-kid=\"1-1-2-4\" data-name=\"navigation link reports\" href=\"#\">\n                <i class=\"ti ti-chart-bar text-xl\" data-kid=\"1-1-2-4-1\" data-name=\"chart icon\">\n                </i>\n                <span class=\"font-medium\" data-kid=\"1-1-2-4-2\" data-name=\"reports menu label\">\n                    Báo cáo\n                </span>\n            </a>\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-3 text-white/70 hover:text-white hover:bg-white/5 rounded-sm\" data-kid=\"1-1-2-5\" data-name=\"navigation link settings\" href=\"#\">\n                <i class=\"ti ti-settings text-xl\" data-kid=\"1-1-2-5-1\" data-name=\"settings icon\">\n                </i>\n                <span class=\"font-medium\" data-kid=\"1-1-2-5-2\" data-name=\"settings menu label\">\n                    Cài đặt\n                </span>\n            </a>\n        </nav>\n        <div class=\"p-6 border-t border-white/10 mt-auto\" data-kid=\"1-1-3\" data-name=\"admin user profile section\">\n            <div class=\"flex items-center gap-3 mb-6\" data-kid=\"1-1-3-1\" data-name=\"admin info group\">\n                <img alt=\"Avatar\" class=\"w-10 h-10 rounded-sm object-cover grayscale brightness-125\" data-kid=\"1-1-3-1-1\" data-name=\"admin avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=staff-1\"/>\n                <div data-kid=\"1-1-3-1-2\" data-name=\"admin details group\">\n                    <p class=\"text-sm font-semibold\" data-kid=\"1-1-3-1-2-1\" data-name=\"admin name text\">\n                        Minh Phan\n                    </p>\n                    <p class=\"text-xs text-white/50\" data-kid=\"1-1-3-1-2-2\" data-name=\"admin role text\">\n                        Senior Operations\n                    </p>\n                </div>\n            </div>\n            <button class=\"flex items-center gap-2 text-white/40 hover:text-[#FE6F5E] transition-colors text-sm font-medium\" data-kid=\"1-1-3-2\" data-name=\"logout button\">\n                <i class=\"ti ti-logout\" data-kid=\"1-1-3-2-1\" data-name=\"logout icon\">\n                </i>\n                Đăng xuất\n            </button>\n        </div>\n    </aside>\n    <!-- Main Content -->\n    <main class=\"flex-1 flex flex-col overflow-hidden\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Header -->\n        <header class=\"h-20 bg-white border-b border-gray-200 px-8 flex items-center justify-between shrink-0\" data-kid=\"1-2-1\" data-name=\"main content header\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page breadcrumb and title group\">\n                <nav class=\"text-xs font-bold tracking-widest text-gray-400 uppercase mb-1\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb navigation text\">\n                    TỔNG QUAN /\n                    <span class=\"text-[#003153]\" data-kid=\"1-2-1-1-1-1\" data-name=\"current page indicator\">\n                        VẬN HÀNH\n                    </span>\n                </nav>\n                <h2 class=\"font-heading font-bold text-xl uppercase tracking-tight\" data-kid=\"1-2-1-1-2\" data-name=\"page title\">\n                    Duyệt hồ sơ gia sư\n                </h2>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-2-1-2\" data-name=\"header action items\">\n                <div class=\"relative group\" data-kid=\"1-2-1-2-1\" data-name=\"search input container\">\n                    <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" data-kid=\"1-2-1-2-1-1\" data-name=\"search icon\">\n                    </i>\n                    <input class=\"bg-[#F8F9FA] border border-transparent focus:border-[#FE6F5E] focus:bg-white outline-hidden pl-10 pr-4 py-2 text-sm w-64 transition-all rounded-xs\" data-kid=\"1-2-1-2-1-2\" data-name=\"search input field\" placeholder=\"Tìm kiếm hồ sơ...\" type=\"text\"/>\n                </div>\n                <div class=\"flex items-center gap-2 text-xs font-bold text-gray-500 bg-[#F8F9FA] px-3 py-2 rounded-xs\" data-kid=\"1-2-1-2-2\" data-name=\"date display badge\">\n                    <i class=\"ti ti-calendar text-sm\" data-kid=\"1-2-1-2-2-1\" data-name=\"calendar icon\">\n                    </i>\n                    THỨ HAI, 10 THÁNG 8, 2026\n                </div>\n            </div>\n        </header>\n        <!-- Viewport Container -->\n        <div class=\"flex-1 overflow-y-auto custom-scrollbar p-8 swiss-grid\" data-kid=\"1-2-2\" data-name=\"viewport scrolling container\">\n            <!-- Hero Command Center Metrics -->\n            <section class=\"grid grid-cols-12 gap-6 mb-8\" data-kid=\"1-2-2-1\" data-name=\"metrics dashboard section\">\n                <!-- Dominant Coral Card -->\n                <div class=\"col-span-7 bg-[#FE6F5E] text-white p-10 relative overflow-hidden group flex flex-col justify-center\" data-kid=\"1-2-2-1-1\" data-name=\"pending profiles metric card\">\n                    <div class=\"relative z-10\" data-kid=\"1-2-2-1-1-1\" data-name=\"metric content wrapper\">\n                        <div class=\"flex items-center gap-3 mb-3\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"queue status group\">\n                            <span class=\"text-xs font-bold uppercase tracking-[0.2em] opacity-80\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"status label text\">\n                                Trạng thái hàng đợi\n                            </span>\n                            <div class=\"w-2 h-2 rounded-full bg-white pulse-dot\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"live pulse indicator\">\n                            </div>\n                        </div>\n                        <h3 class=\"font-heading font-black text-5xl mb-4 leading-none uppercase tracking-tighter\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"metric value headline\">\n                            34 Hồ sơ chờ duyệt\n                        </h3>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"trend indicator group\">\n                            <i class=\"ti ti-trending-up text-xl\" data-kid=\"1-2-2-1-1-1-3-1\" data-name=\"trending up icon\">\n                            </i>\n                            <span class=\"font-medium text-lg\" data-kid=\"1-2-2-1-1-1-3-2\" data-name=\"trend percentage text\">\n                                Tăng 12% so với tuần trước\n                            </span>\n                        </div>\n                    </div>\n                    <!-- Aesthetic shape in background -->\n                    <i class=\"ti ti-layers-intersect absolute -bottom-10 -right-10 text-[200px] opacity-10 rotate-12\" data-kid=\"1-2-2-1-1-2\" data-name=\"decorative background icon\">\n                    </i>\n                </div>\n                <!-- Smaller Neutral Cards -->\n                <div class=\"col-span-5 flex flex-col gap-6\" data-kid=\"1-2-2-1-2\" data-name=\"side metrics container\">\n                    <div class=\"flex-1 bg-white border border-gray-200 p-8 flex flex-col justify-between hover:border-[#003153] transition-colors\" data-kid=\"1-2-2-1-2-1\" data-name=\"daily approvals card\">\n                        <div class=\"flex justify-between items-start\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"card header group\">\n                            <span class=\"text-xs font-bold text-gray-400 uppercase tracking-[0.15em]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"label text\">\n                                Đã duyệt hôm nay\n                            </span>\n                            <div class=\"w-10 h-10 bg-[#F8F9FA] flex items-center justify-center\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"icon wrapper\">\n                                <i class=\"ti ti-circle-check text-xl text-[#003153]\" data-kid=\"1-2-2-1-2-1-1-2-1\" data-name=\"check icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <p class=\"font-heading font-bold text-5xl text-[#003153]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"metric value text\">\n                            12\n                        </p>\n                    </div>\n                    <div class=\"flex-1 bg-white border border-gray-200 p-8 flex flex-col justify-between hover:border-[#003153] transition-colors\" data-kid=\"1-2-2-1-2-2\" data-name=\"average processing time card\">\n                        <div class=\"flex justify-between items-start\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"card header group\">\n                            <span class=\"text-xs font-bold text-gray-400 uppercase tracking-[0.15em]\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"label text\">\n                                Thời gian xử lý TB\n                            </span>\n                            <div class=\"w-10 h-10 bg-[#F8F9FA] flex items-center justify-center\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"icon wrapper\">\n                                <i class=\"ti ti-clock-hour-4 text-xl text-[#003153]\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"clock icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div class=\"flex items-baseline gap-2\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"metric value group\">\n                            <p class=\"font-heading font-bold text-5xl text-[#003153]\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"metric value text\">\n                                2.4h\n                            </p>\n                            <span class=\"text-xs font-semibold text-gray-400\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"metric unit text\">\n                                / hồ sơ\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Workspace: Master Detail -->\n            <div class=\"flex gap-8 items-start mb-8\" data-kid=\"1-2-2-2\" data-name=\"master detail workspace\">\n                <!-- Master Table (60%) -->\n                <section class=\"w-[60%] bg-white border border-gray-200\" data-kid=\"1-2-2-2-1\" data-name=\"master table section\">\n                    <div class=\"p-6 border-b border-gray-200 flex items-center justify-between\" data-kid=\"1-2-2-2-1-1\" data-name=\"table header group\">\n                        <h3 class=\"font-heading font-bold uppercase tracking-[0.05em]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"table title\">\n                            Hàng đợi duyệt hồ sơ\n                        </h3>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"filter button group\">\n                            <button class=\"text-xs font-bold px-3 py-1.5 bg-[#003153] text-white cursor-pointer\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"all filter button\">\n                                TẤT CẢ\n                            </button>\n                            <button class=\"text-xs font-bold px-3 py-1.5 bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors cursor-pointer\" data-kid=\"1-2-2-2-1-1-2-2\" data-name=\"emergency filter button\">\n                                KHẨN CẤP\n                            </button>\n                            <button class=\"text-xs font-bold px-3 py-1.5 bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors cursor-pointer\" data-kid=\"1-2-2-2-1-1-2-3\" data-name=\"long-pending filter button\">\n                                LÂU NGÀY\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"w-full\" data-kid=\"1-2-2-2-1-2\" data-name=\"table wrapper\">\n                        <table class=\"w-full text-left border-collapse\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"data table\">\n                            <thead data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"table header row\">\n                                <tr class=\"bg-[#F8F9FA] text-xs font-semibold text-gray-400 uppercase tracking-[0.1em] border-b border-gray-200\" data-kid=\"1-2-2-2-1-2-1-1-1\" data-name=\"header column name\">\n                                    <th class=\"px-6 py-5 w-[30%]\" data-kid=\"1-2-2-2-1-2-1-1-1-1\" data-name=\"header name\">\n                                        Họ và tên\n                                    </th>\n                                    <th class=\"px-6 py-5 w-[35%]\" data-kid=\"1-2-2-2-1-2-1-1-1-2\" data-name=\"header subject\">\n                                        Môn đăng ký\n                                    </th>\n                                    <th class=\"px-6 py-5 w-[15%] text-center\" data-kid=\"1-2-2-2-1-2-1-1-1-3\" data-name=\"header date\">\n                                        Ngày nộp\n                                    </th>\n                                    <th class=\"px-6 py-5 w-[20%] text-right\" data-kid=\"1-2-2-2-1-2-1-1-1-4\" data-name=\"header score\">\n                                        Trust Score\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"table body\" id=\"tutor-table-body\">\n                                <tr class=\"table-row selected border-b border-gray-100\" data-kid=\"1-2-2-2-1-2-1-2-1\" data-name=\"row one\" onclick=\"selectRow(this, 'Nguyễn Minh Anh')\">\n                                    <td class=\"px-6 py-6 font-bold text-[#003153]\" data-kid=\"1-2-2-2-1-2-1-2-1-1\" data-name=\"tutor name\">\n                                        Nguyễn Minh Anh\n                                    </td>\n                                    <td class=\"px-6 py-6 text-sm text-[#003153]\" data-kid=\"1-2-2-2-1-2-1-2-1-2\" data-name=\"tutor subjects\">\n                                        Tiếng Anh, IELTS\n                                    </td>\n                                    <td class=\"px-6 py-6 text-sm text-gray-500 text-center\" data-kid=\"1-2-2-2-1-2-1-2-1-3\" data-name=\"date submitted\">\n                                        10/08/2026\n                                    </td>\n                                    <td class=\"px-6 py-6 text-right font-mono font-bold text-[#FE6F5E]\" data-kid=\"1-2-2-2-1-2-1-2-1-4\" data-name=\"trust score\">\n                                        98%\n                                    </td>\n                                </tr>\n                                <tr class=\"table-row border-b border-gray-100\" data-kid=\"1-2-2-2-1-2-1-2-2\" data-name=\"row two\" onclick=\"selectRow(this, 'Trần Quốc Bảo')\">\n                                    <td class=\"px-6 py-6 font-bold text-gray-600\" data-kid=\"1-2-2-2-1-2-1-2-2-1\" data-name=\"tutor name\">\n                                        Trần Quốc Bảo\n                                    </td>\n                                    <td class=\"px-6 py-6 text-sm text-gray-500\" data-kid=\"1-2-2-2-1-2-1-2-2-2\" data-name=\"tutor subjects\">\n                                        Toán Cao Cấp\n                                    </td>\n                                    <td class=\"px-6 py-6 text-sm text-gray-500 text-center\" data-kid=\"1-2-2-2-1-2-1-2-2-3\" data-name=\"date submitted\">\n                                        09/08/2026\n                                    </td>\n                                    <td class=\"px-6 py-6 text-right font-mono font-bold text-gray-400\" data-kid=\"1-2-2-2-1-2-1-2-2-4\" data-name=\"trust score\">\n                                        85%\n                                    </td>\n                                </tr>\n                                <tr class=\"table-row border-b border-gray-100\" data-kid=\"1-2-2-2-1-2-1-2-3\" data-name=\"row three\" onclick=\"selectRow(this, 'Lê Hoàng Yến')\">\n                                    <td class=\"px-6 py-5 font-bold text-gray-600\" data-kid=\"1-2-2-2-1-2-1-2-3-1\" data-name=\"tutor name\">\n                                        Lê Hoàng Yến\n                                    </td>\n                                    <td class=\"px-6 py-5 text-sm text-gray-500\" data-kid=\"1-2-2-2-1-2-1-2-3-2\" data-name=\"tutor subjects\">\n                                        Ngữ Văn, Lịch sử\n                                    </td>\n                                    <td class=\"px-6 py-5 text-sm text-gray-500 text-center\" data-kid=\"1-2-2-2-1-2-1-2-3-3\" data-name=\"date submitted\">\n                                        09/08/2026\n                                    </td>\n                                    <td class=\"px-6 py-5 text-right font-mono font-bold text-gray-400\" data-kid=\"1-2-2-2-1-2-1-2-3-4\" data-name=\"trust score\">\n                                        92%\n                                    </td>\n                                </tr>\n                                <tr class=\"table-row border-b border-gray-100\" data-kid=\"1-2-2-2-1-2-1-2-4\" data-name=\"row four\" onclick=\"selectRow(this, 'Phạm Gia Huy')\">\n                                    <td class=\"px-6 py-5 font-bold text-gray-600\" data-kid=\"1-2-2-2-1-2-1-2-4-1\" data-name=\"tutor name\">\n                                        Phạm Gia Huy\n                                    </td>\n                                    <td class=\"px-6 py-5 text-sm text-gray-500\" data-kid=\"1-2-2-2-1-2-1-2-4-2\" data-name=\"tutor subjects\">\n                                        Vật Lý, Hóa Học\n                                    </td>\n                                    <td class=\"px-6 py-5 text-sm text-gray-500 text-center\" data-kid=\"1-2-2-2-1-2-1-2-4-3\" data-name=\"date submitted\">\n                                        08/08/2026\n                                    </td>\n                                    <td class=\"px-6 py-5 text-right font-mono font-bold text-gray-400\" data-kid=\"1-2-2-2-1-2-1-2-4-4\" data-name=\"trust score\">\n                                        76%\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                </section>\n                <!-- Detail Panel (40%) sticky-like -->\n                <section class=\"w-[42%] sticky top-0 bg-white border border-gray-200 p-6\" data-kid=\"1-2-2-2-2\" data-name=\"detail panel container\">\n                    <div data-dynamic=\"true\" data-kid=\"1-2-2-2-2-1\" data-name=\"detail panel content\" data-reason=\"text content replaced by selection script\" id=\"detail-panel-content\">\n                        <div class=\"flex items-start gap-6 mb-8\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"tutor header info\">\n                            <img alt=\"Sơn Tốt Việt on Unsplash\" class=\"w-32 h-44 object-cover rounded-xs border-2 border-[#003153]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"tutor profile image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1740153204493-a40521839a21?auto=format&w=240&q=80&fit=crop\"/>\n                            <div class=\"flex-1 overflow-hidden\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"tutor profile meta\">\n                                <h4 class=\"font-heading font-bold text-2xl mb-1 uppercase leading-tight truncate\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-1-1-2-1\" data-name=\"tutor full name\" data-reason=\"text replaced by selection script\">\n                                    Nguyễn Minh Anh\n                                </h4>\n                                <p class=\"text-xs font-bold text-[#FE6F5E] mb-4 tracking-widest\" data-kid=\"1-2-2-2-2-1-1-2-2\" data-name=\"candidate status badge\">\n                                    PREMIUM TUTOR CANDIDATE\n                                </p>\n                                <div class=\"space-y-3 text-xs\" data-kid=\"1-2-2-2-2-1-1-2-3\" data-name=\"tutor bio details\">\n                                    <div class=\"flex items-center justify-between border-b border-gray-100 pb-2 gap-4\" data-kid=\"1-2-2-2-2-1-1-2-3-1\" data-name=\"info row one\">\n                                        <span class=\"text-gray-400 whitespace-nowrap\" data-kid=\"1-2-2-2-2-1-1-2-3-1-1\" data-name=\"label\">\n                                            Năm sinh\n                                        </span>\n                                        <span class=\"font-semibold text-right\" data-kid=\"1-2-2-2-2-1-1-2-3-1-2\" data-name=\"value\">\n                                            2001\n                                        </span>\n                                    </div>\n                                    <div class=\"flex items-center justify-between border-b border-gray-100 pb-2 gap-4\" data-kid=\"1-2-2-2-2-1-1-2-3-2\" data-name=\"info row two\">\n                                        <span class=\"text-gray-400 whitespace-nowrap\" data-kid=\"1-2-2-2-2-1-1-2-3-2-1\" data-name=\"label\">\n                                            Học vấn\n                                        </span>\n                                        <span class=\"font-semibold text-right\" data-kid=\"1-2-2-2-2-1-1-2-3-2-2\" data-name=\"value\">\n                                            ĐH Ngoại Thương\n                                        </span>\n                                    </div>\n                                    <div class=\"flex items-center justify-between border-b border-gray-100 pb-2 gap-4\" data-kid=\"1-2-2-2-2-1-1-2-3-3\" data-name=\"info row three\">\n                                        <span class=\"text-gray-400 whitespace-nowrap\" data-kid=\"1-2-2-2-2-1-1-2-3-3-1\" data-name=\"label\">\n                                            Kinh nghiệm\n                                        </span>\n                                        <span class=\"font-semibold text-right\" data-kid=\"1-2-2-2-2-1-1-2-3-3-2\" data-name=\"value\">\n                                            3 năm giảng dạy\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mb-8\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"document attachment section\">\n                            <h5 class=\"text-xs font-bold text-gray-400 uppercase tracking-[0.2em] mb-4\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"section title\">\n                                Tài liệu đính kèm\n                            </h5>\n                            <div class=\"grid grid-cols-2 gap-3\" data-kid=\"1-2-2-2-2-1-2-2\" data-name=\"documents grid\">\n                                <div class=\"border border-gray-200 p-3 flex flex-col gap-2 hover:bg-gray-50 transition-colors cursor-pointer group\" data-kid=\"1-2-2-2-2-1-2-2-1\" data-name=\"cv document card\">\n                                    <div class=\"flex justify-between items-center text-xs text-gray-500 font-bold uppercase group-hover:text-[#003153]\" data-kid=\"1-2-2-2-2-1-2-2-1-1\" data-name=\"header group\">\n                                        <span data-kid=\"1-2-2-2-2-1-2-2-1-1-1\" data-name=\"document name\">\n                                            CV.PDF\n                                        </span>\n                                        <i class=\"ti ti-file-text\" data-kid=\"1-2-2-2-2-1-2-2-1-1-2\" data-name=\"document icon\">\n                                        </i>\n                                    </div>\n                                    <div class=\"h-16 bg-[#F8F9FA] flex items-center justify-center\" data-kid=\"1-2-2-2-2-1-2-2-1-2\" data-name=\"thumbnail area\">\n                                        <i class=\"ti ti-zoom-in text-gray-300\" data-kid=\"1-2-2-2-2-1-2-2-1-2-1\" data-name=\"preview icon\">\n                                        </i>\n                                    </div>\n                                </div>\n                                <div class=\"border border-gray-200 p-3 flex flex-col gap-2 hover:bg-gray-50 transition-colors cursor-pointer group\" data-kid=\"1-2-2-2-2-1-2-2-2\" data-name=\"id document card\">\n                                    <div class=\"flex justify-between items-center text-xs text-gray-500 font-bold uppercase group-hover:text-[#003153]\" data-kid=\"1-2-2-2-2-1-2-2-2-1\" data-name=\"header group\">\n                                        <span data-kid=\"1-2-2-2-2-1-2-2-2-1-1\" data-name=\"document name\">\n                                            CCCD.JPG\n                                        </span>\n                                        <i class=\"ti ti-id\" data-kid=\"1-2-2-2-2-1-2-2-2-1-2\" data-name=\"document icon\">\n                                        </i>\n                                    </div>\n                                    <div class=\"h-16 bg-[#F8F9FA] flex items-center justify-center\" data-kid=\"1-2-2-2-2-1-2-2-2-2\" data-name=\"thumbnail area\">\n                                        <i class=\"ti ti-zoom-in text-gray-300\" data-kid=\"1-2-2-2-2-1-2-2-2-2-1\" data-name=\"preview icon\">\n                                        </i>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mb-8\" data-kid=\"1-2-2-2-2-1-3\" data-name=\"verification checklist section\">\n                            <h5 class=\"text-xs font-bold text-gray-400 uppercase tracking-[0.2em] mb-4\" data-kid=\"1-2-2-2-2-1-3-1\" data-name=\"section title\">\n                                Kiểm định hồ sơ\n                            </h5>\n                            <div class=\"space-y-3\" data-kid=\"1-2-2-2-2-1-3-2\" data-name=\"checklist container\">\n                                <label class=\"flex items-center gap-3 cursor-pointer group\" data-kid=\"1-2-2-2-2-1-3-2-1\" data-name=\"checklist item\">\n                                    <input checked=\"\" class=\"w-4 h-4 accent-[#003153]\" data-kid=\"1-2-2-2-2-1-3-2-1-1\" data-name=\"checkbox input\" type=\"checkbox\"/>\n                                    <span class=\"text-sm font-medium text-gray-700 group-hover:text-[#003153]\" data-kid=\"1-2-2-2-2-1-3-2-1-2\" data-name=\"label text\">\n                                        Xác minh danh tính qua CCCD\n                                    </span>\n                                </label>\n                                <label class=\"flex items-center gap-3 cursor-pointer group\" data-kid=\"1-2-2-2-2-1-3-2-2\" data-name=\"checklist item\">\n                                    <input checked=\"\" class=\"w-4 h-4 accent-[#003153]\" data-kid=\"1-2-2-2-2-1-3-2-2-1\" data-name=\"checkbox input\" type=\"checkbox\"/>\n                                    <span class=\"text-sm font-medium text-gray-700 group-hover:text-[#003153]\" data-kid=\"1-2-2-2-2-1-3-2-2-2\" data-name=\"label text\">\n                                        Kiểm tra bằng cấp chuyên môn\n                                    </span>\n                                </label>\n                                <label class=\"flex items-center gap-3 cursor-pointer group\" data-kid=\"1-2-2-2-2-1-3-2-3\" data-name=\"checklist item\">\n                                    <input class=\"w-4 h-4 accent-[#003153]\" data-kid=\"1-2-2-2-2-1-3-2-3-1\" data-name=\"checkbox input\" type=\"checkbox\"/>\n                                    <span class=\"text-sm font-medium text-gray-700 group-hover:text-[#003153]\" data-kid=\"1-2-2-2-2-1-3-2-3-2\" data-name=\"label text\">\n                                        Đối soát số điện thoại & Email\n                                    </span>\n                                </label>\n                            </div>\n                        </div>\n                        <div class=\"mb-8\" data-kid=\"1-2-2-2-2-1-4\" data-name=\"rejection note section\">\n                            <label class=\"text-xs font-bold text-gray-400 uppercase tracking-[0.2em] mb-2 block\" data-kid=\"1-2-2-2-2-1-4-1\" data-name=\"section label\">\n                                Ghi chú từ chối (nếu có)\n                            </label>\n                            <textarea class=\"w-full h-20 border border-gray-200 p-3 text-sm focus:border-[#FE6F5E] outline-hidden resize-none bg-[#F8F9FA]\" data-kid=\"1-2-2-2-2-1-4-2\" data-name=\"note textarea\" placeholder=\"Lý do từ chối hồ sơ...\"></textarea>\n                        </div>\n                        <div class=\"flex gap-3\" data-kid=\"1-2-2-2-2-1-5\" data-name=\"action button group\">\n                            <button class=\"flex-1 bg-[#003153] text-white font-bold text-xs py-4 uppercase tracking-widest hover:bg-[#002138] transition-colors active:scale-95\" data-kid=\"1-2-2-2-2-1-5-1\" data-name=\"approve button\" onclick=\"showToast('Hồ sơ đã được phê duyệt')\">\n                                Phê duyệt hồ sơ\n                            </button>\n                            <button class=\"px-6 border border-[#003153] text-[#003153] font-bold text-xs py-4 uppercase tracking-widest hover:bg-gray-50 transition-colors active:scale-95\" data-kid=\"1-2-2-2-2-1-5-2\" data-name=\"reject button\" onclick=\"showToast('Đã gửi thông báo từ chối')\">\n                                Từ chối\n                            </button>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </div>\n        <!-- Bottom Footer / Live Ticker -->\n        <footer class=\"h-12 bg-[#003153] text-white flex items-center justify-between px-8 text-xs font-bold tracking-widest uppercase shrink-0 border-t border-white/5\" data-kid=\"1-2-3\" data-name=\"footer ticker bar\">\n            <div class=\"flex items-center gap-4 overflow-hidden flex-1 mr-12\" data-kid=\"1-2-3-1\" data-name=\"ticker message group\">\n                <div class=\"flex items-center gap-2 text-[#FE6F5E] whitespace-nowrap shrink-0 bg-[#003153] z-10 pr-4\" data-kid=\"1-2-3-1-1\" data-name=\"live label group\">\n                    <div class=\"w-2 h-2 rounded-full bg-[#FE6F5E] pulse-dot\" data-kid=\"1-2-3-1-1-1\" data-name=\"live pulse dot\">\n                    </div>\n                    <span data-kid=\"1-2-3-1-1-2\" data-name=\"ticker status label\">\n                        LIVE TICKER:\n                    </span>\n                </div>\n                <div class=\"flex-1 overflow-hidden relative\" data-kid=\"1-2-3-1-2\" data-name=\"scrolling text viewport\">\n                    <div class=\"ticker-scroll flex gap-12 text-white/50\" data-kid=\"1-2-3-1-2-1\" data-name=\"marquee text content\">\n                        <span data-kid=\"1-2-3-1-2-1-1\" data-name=\"message one\">\n                            Staff 201: Duyệt Lê Minh Tùng\n                            <span class=\"text-white/20 ml-1\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"time stamp\">\n                                12:45\n                            </span>\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-2\" data-name=\"message two\">\n                            Hệ thống: Cảnh báo Trust Score thấp (ID: 992)\n                            <span class=\"text-white/20 ml-1\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"time stamp\">\n                                12:44\n                            </span>\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-3\" data-name=\"message three\">\n                            Staff 104: Từ chối Trần Văn A\n                            <span class=\"text-white/20 ml-1\" data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"time stamp\">\n                                12:40\n                            </span>\n                        </span>\n                        <!-- Repeat for seamless scroll -->\n                        <span data-kid=\"1-2-3-1-2-1-4\" data-name=\"repeat message one\">\n                            Staff 201: Duyệt Lê Minh Tùng\n                            <span class=\"text-white/20 ml-1\" data-kid=\"1-2-3-1-2-1-4-1\" data-name=\"time stamp\">\n                                12:45\n                            </span>\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-5\" data-name=\"repeat message two\">\n                            Hệ thống: Cảnh báo Trust Score thấp (ID: 992)\n                            <span class=\"text-white/20 ml-1\" data-kid=\"1-2-3-1-2-1-5-1\" data-name=\"time stamp\">\n                                12:44\n                            </span>\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-6\" data-name=\"repeat message three\">\n                            Staff 104: Từ chối Trần Văn A\n                            <span class=\"text-white/20 ml-1\" data-kid=\"1-2-3-1-2-1-6-1\" data-name=\"time stamp\">\n                                12:40\n                            </span>\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-2-3-2\" data-name=\"status info group\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-2-1\" data-name=\"sla status group\">\n                    <span class=\"text-white/40\" data-kid=\"1-2-3-2-1-1\" data-name=\"sla label\">\n                        SLA 48H:\n                    </span>\n                    <div class=\"w-32 h-1 bg-white/10 relative overflow-hidden\" data-kid=\"1-2-3-2-1-2\" data-name=\"sla progress container\">\n                        <div class=\"absolute inset-0 bg-[#FE6F5E] w-[88%]\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"sla progress bar\">\n                        </div>\n                    </div>\n                    <span data-kid=\"1-2-3-2-1-3\" data-name=\"sla percentage text\">\n                        88%\n                    </span>\n                </div>\n                <div class=\"h-4 w-[1px] bg-white/10\" data-kid=\"1-2-3-2-2\" data-name=\"vertical divider\">\n                </div>\n                <div class=\"text-[#FE6F5E]\" data-kid=\"1-2-3-2-3\" data-name=\"system version badge\">\n                    SYS_STABLE_V1.0.4\n                </div>\n            </div>\n        </footer>\n    </main>\n    <!-- Toast Notification -->\n    <div class=\"fixed bottom-16 right-8 bg-[#003153] text-white p-4 border-l-4 border-[#FE6F5E] translate-y-20 opacity-0 transition-all duration-300 z-50 shadow-2xl flex items-center gap-3 pointer-events-none\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"toast notification box\" data-reason=\"visibility and message updated by script\" id=\"toast\">\n        <i class=\"ti ti-info-circle text-[#FE6F5E] text-xl\" data-kid=\"1-3-1\" data-name=\"info icon\">\n        </i>\n        <span class=\"text-xs font-bold uppercase tracking-wider\" data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"message text\" data-reason=\"text content updated by script\" id=\"toast-message\">\n            Hành động thành công\n        </span>\n    </div>\n    <script>\n        function selectRow(el, name) {\n            // Remove selection from all rows\n            document.querySelectorAll('.table-row').forEach(row => {\n                row.classList.remove('selected');\n                row.querySelector('td').classList.add('text-gray-600');\n                row.querySelector('td').classList.remove('text-[#003153]');\n            });\n            \n            // Add selection to clicked row\n            el.classList.add('selected');\n            el.querySelector('td').classList.remove('text-gray-600');\n            el.querySelector('td').classList.add('text-[#003153]');\n\n            // Update Detail Panel (Simulation)\n            const detailPanel = document.getElementById('detail-panel-content');\n            detailPanel.style.opacity = '0';\n            detailPanel.style.transform = 'translateX(10px)';\n            \n            setTimeout(() => {\n                const nameNode = detailPanel.querySelector('h4');\n                nameNode.textContent = name;\n                \n                // Simulate image change\n                const imgNode = detailPanel.querySelector('img');\n                const seed = name.split(' ').join('');\n                imgNode.src = `https://images.unsplash.com/photo-1740153204493-a40521839a21?auto=format&w=240&q=80&fit=crop`; // Keeping original as per instruction but in real app it would change\n\n                detailPanel.style.transition = 'all 0.4s ease';\n                detailPanel.style.opacity = '1';\n                detailPanel.style.transform = 'translateX(0)';\n            }, 200);\n        }\n\n        function showToast(message) {\n            const toast = document.getElementById('toast');\n            const msg = document.getElementById('toast-message');\n            msg.textContent = message;\n            \n            toast.classList.remove('translate-y-20', 'opacity-0');\n            toast.classList.add('translate-y-0', 'opacity-100');\n            \n            setTimeout(() => {\n                toast.classList.add('translate-y-20', 'opacity-0');\n                toast.classList.remove('translate-y-0', 'opacity-100');\n            }, 3000);\n        }\n\n        // Initialize hover sounds or additional micro-interactions if needed\n        document.querySelectorAll('button').forEach(btn => {\n            btn.addEventListener('mouseenter', () => {\n                // Subtle hover effect\n            });\n        });\n    </script>\n</div>\n",
