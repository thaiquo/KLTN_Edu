       Lớp học\n                                </a>\n                            </li>\n                            <li data-kid=\"3-2-7-1-1-2-2-3\" data-name=\"link\">\n                                <a class=\"text-slate-500 hover:text-blue-600 transition-colors\" data-kid=\"3-2-7-1-1-2-2-3-1\" data-name=\"link\" href=\"#\">\n                                    AI Match\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"3-2-7-1-1-3\" data-name=\"support column\">\n                        <h4 class=\"font-black text-slate-900 mb-8 uppercase text-xs tracking-[0.2em]\" data-kid=\"3-2-7-1-1-3-1\" data-name=\"column header\">\n                            Hỗ trợ\n                        </h4>\n                        <ul class=\"space-y-4\" data-kid=\"3-2-7-1-1-3-2\" data-name=\"link list\">\n                            <li data-kid=\"3-2-7-1-1-3-2-1\" data-name=\"link\">\n                                <a class=\"text-slate-500 hover:text-blue-600 transition-colors\" data-kid=\"3-2-7-1-1-3-2-1-1\" data-name=\"link\" href=\"#\">\n                                    Help Center\n                                </a>\n                            </li>\n                            <li data-kid=\"3-2-7-1-1-3-2-2\" data-name=\"link\">\n                                <a class=\"text-slate-500 hover:text-blue-600 transition-colors\" data-kid=\"3-2-7-1-1-3-2-2-1\" data-name=\"link\" href=\"#\">\n                                    Security\n                                </a>\n                            </li>\n                            <li data-kid=\"3-2-7-1-1-3-2-3\" data-name=\"link\">\n                                <a class=\"text-slate-500 hover:text-blue-600 transition-colors\" data-kid=\"3-2-7-1-1-3-2-3-1\" data-name=\"link\" href=\"#\">\n                                    Contract Info\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"3-2-7-1-1-4\" data-name=\"legal column\">\n                        <h4 class=\"font-black text-slate-900 mb-8 uppercase text-xs tracking-[0.2em]\" data-kid=\"3-2-7-1-1-4-1\" data-name=\"column header\">\n                            Pháp lý\n                        </h4>\n                        <ul class=\"space-y-4\" data-kid=\"3-2-7-1-1-4-2\" data-name=\"link list\">\n                            <li data-kid=\"3-2-7-1-1-4-2-1\" data-name=\"link\">\n                                <a class=\"text-slate-500 hover:text-blue-600 transition-colors\" data-kid=\"3-2-7-1-1-4-2-1-1\" data-name=\"link\" href=\"#\">\n                                    Privacy\n                                </a>\n                            </li>\n                            <li data-kid=\"3-2-7-1-1-4-2-2\" data-name=\"link\">\n                                <a class=\"text-slate-500 hover:text-blue-600 transition-colors\" data-kid=\"3-2-7-1-1-4-2-2-1\" data-name=\"link\" href=\"#\">\n                                    Blockchain Policy\n                                </a>\n                            </li>\n                            <li data-kid=\"3-2-7-1-1-4-2-3\" data-name=\"link\">\n                                <a class=\"text-slate-500 hover:text-blue-600 transition-colors\" data-kid=\"3-2-7-1-1-4-2-3-1\" data-name=\"link\" href=\"#\">\n                                    Terms\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n                <div class=\"flex justify-between items-center pt-12 border-t border-slate-200\" data-kid=\"3-2-7-1-2\" data-name=\"footer bottom row\">\n                    <p class=\"text-slate-400 text-xs\" data-kid=\"3-2-7-1-2-1\" data-name=\"copyright text\">\n                        © 2024 Kết Nối Học. Technology and Trust.\n                    </p>\n                    <div class=\"flex gap-8\" data-kid=\"3-2-7-1-2-2\" data-name=\"social icons\">\n                        <a class=\"text-slate-400 hover:text-slate-900\" data-kid=\"3-2-7-1-2-2-1\" data-name=\"facebook link\" href=\"#\">\n                            <i class=\"ti ti-brand-facebook text-xl\" data-kid=\"3-2-7-1-2-2-1-1\" data-name=\"facebook icon\">\n                            </i>\n                        </a>\n                        <a class=\"text-slate-400 hover:text-slate-900\" data-kid=\"3-2-7-1-2-2-2\" data-name=\"linkedin link\" href=\"#\">\n                            <i class=\"ti ti-brand-linkedin text-xl\" data-kid=\"3-2-7-1-2-2-2-1\" data-name=\"linkedin icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis\n    const lenis = new Lenis({\n        lerp: 0.1,\n        duration: 1.2\n    });\n\n    // Synchronize Lenis with GSAP ScrollTrigger\n    lenis.on('scroll', ScrollTrigger.update);\n    gsap.ticker.add((time) => {\n        lenis.raf(time * 1000);\n    });\n    gsap.ticker.lagSmoothing(0);\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Entrance\n    const heroTl = gsap.timeline();\n    heroTl.from(\".hero-stagger\", {\n        y: 40,\n        opacity: 0,\n        duration: 1.2,\n        stagger: 0.1,\n        ease: \"power4.out\"\n    }).from(\"#hero-grounded-mockup\", {\n        scale: 0.9,\n        opacity: 0,\n        duration: 1.5,\n        ease: \"expo.out\"\n    }, \"-=1\");\n\n    // Section Reveals using ScrollTrigger directly\n    const revealSections = [\n        { trigger: \"#dual-path .path-card\", x: 50, stagger: 0.2 },\n        { trigger: \"#featured .tutor-card\", y: 50, stagger: 0.1 },\n        { trigger: \"#trust-tech .trust-feature\", x: -30, stagger: 0.15 },\n        { trigger: \"#trust-visual\", scale: 0.9, opacity: 0 },\n        { trigger: \"#testimonial\", opacity: 0, y: 30 },\n        { trigger: \"#final-cta h2\", y: 60, opacity: 0 }\n    ];\n\n    revealSections.forEach(reveal => {\n        const targets = document.querySelectorAll(reveal.trigger);\n        if(targets.length > 0) {\n            gsap.from(targets, {\n                scrollTrigger: {\n                    trigger: targets[0],\n                    start: \"top 80%\",\n                    toggleActions: \"play none none none\"\n                },\n                y: reveal.y || 0,\n                x: reveal.x || 0,\n                scale: reveal.scale || 1,\n                opacity: reveal.opacity !== undefined ? reveal.opacity : 0,\n                duration: 1,\n                stagger: reveal.stagger || 0,\n                ease: \"power3.out\"\n            });\n        }\n    });\n\n    // Tab Switching\n    window.switchTab = (tab) => {\n        const tutorsBtn = document.getElementById('tab-tutors');\n        const classesBtn = document.getElementById('tab-classes');\n        const tutorsContent = document.getElementById('content-tutors');\n        const classesContent = document.getElementById('content-classes');\n\n        if (tab === 'tutors') {\n            tutorsBtn.classList.add('bg-white', 'shadow-xl', 'shadow-slate-900/5', 'text-blue-600');\n            tutorsBtn.classList.remove('text-slate-500');\n            classesBtn.classList.remove('bg-white', 'shadow-xl', 'shadow-slate-900/5', 'text-blue-600');\n            classesBtn.classList.add('text-slate-500');\n            tutorsContent.classList.remove('hidden');\n            classesContent.classList.add('hidden');\n            \n            gsap.from(\"#content-tutors .tutor-card\", {\n                y: 20,\n                opacity: 0,\n                stagger: 0.1,\n                duration: 0.6\n            });\n        } else {\n            classesBtn.classList.add('bg-white', 'shadow-xl', 'shadow-slate-900/5', 'text-blue-600');\n            classesBtn.classList.remove('text-slate-500');\n            tutorsBtn.classList.remove('bg-white', 'shadow-xl', 'shadow-slate-900/5', 'text-blue-600');\n            tutorsBtn.classList.add('text-slate-500');\n            classesContent.classList.remove('hidden');\n            tutorsContent.classList.add('hidden');\n            \n            gsap.from(\".class-item\", {\n                y: 20,\n                opacity: 0,\n                stagger: 0.1,\n                duration: 0.6\n            });\n        }\n        ScrollTrigger.refresh();\n    };\n\n    // Global ScrollTrigger Refresh on all images loaded\n    window.addEventListener('load', () => {\n        ScrollTrigger.refresh();\n    });\n</script>\n",
